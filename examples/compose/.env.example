# Copy to .env, or let bin/setup do it and fill in the generated values.
# Every value has a working default for a throwaway local stack.

MYSQL_ROOT_PASSWORD=warpengine

# The token the /build/* endpoints accept from scripts and the by-hand publish
# (X-Update-Secret header); the seed stores it as an application token.
UPDATE_SECRET=example-update-secret

APP_PORT=8080
GITEA_PORT=3000
GITEA_SSH_PORT=2223
WOODPECKER_PORT=8000

# The shelves for the file-reading clients (WARP64U on a C64, DOSINST on DOS). The URLs
# are what the catalog announces; SHELF_FTP_ADDRESS is the address FTP's passive replies
# name: set both to your machine's address on the local network for a real C64 or DOS PC.
SHELF_HTTP_PORT=8090
SHELF_FTP_PORT=2121
SHELF_HTTP_URL=http://localhost:8090
SHELF_FTP_URL=ftp://localhost:2121
SHELF_FTP_ADDRESS=127.0.0.1

# --- profile "ci": written by bin/setup ---------------------------------------

GITEA_ADMIN=warp
GITEA_PASSWORD=warpengine
GITEA_OWNER=games
GITEA_URL=
GITEA_API_TOKEN=

WOODPECKER_AGENT_SECRET=example-agent-secret
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=
WOODPECKER_URL=
WOODPECKER_API_TOKEN=
WOODPECKER_PUBLIC_KEY_URL=
