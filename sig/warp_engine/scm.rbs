module WarpEngine
  module Scm
    # A repository on the scm.
    class Repo
      attr_reader id: Integer | String
      attr_reader owner: String
      attr_reader name: String
      attr_reader html_url: String?
      attr_reader clone_url: String?
      attr_reader ssh_url: String?

      def initialize: (id: Integer | String, owner: String, name: String, html_url: String?,
                       clone_url: String?, ssh_url: String?) -> void
    end

    class Error < WarpEngine::Error
    end

    class NotConfigured < Error
    end

    # Where the engine creates a new software's repository (Gitea, a local
    # SCM provider, or Null).
    interface _Adapter
      def name: () -> String
      def configured?: () -> bool
      def find_repo: (String name) -> Repo?
      def create_repo: (name: String, ?description: String?) -> Repo
      # The number of the open pull request of +branch+, or +nil+.
      def open_pull_request: (owner: String, name: String, branch: String) -> Integer?
      # The id of the comment written.
      def upsert_comment: (owner: String, name: String, number: Integer, marker: String, body: String) -> Integer
    end

    class Null

      def name: () -> String
      def configured?: () -> bool
      def find_repo: (String name) -> nil
      def create_repo: (**untyped) -> bot
      def open_pull_request: (**untyped) -> nil
      def upsert_comment: (**untyped) -> bot
    end

    def self.adapter: () -> (Object & _Adapter)
    def self.reset!: () -> nil

    private

    def self.build: (Hash[Symbol, untyped]? settings) -> (Object & _Adapter)

    self.@adapter: (Object & _Adapter)?
    self.@settings: Hash[Symbol, untyped]?
  end
end
