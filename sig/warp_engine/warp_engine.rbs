# The adapter contracts of WarpEngine: the seams a host may fill with its own
# object. Only these are typed; the rest of the engine is documented by RDoc.
module WarpEngine
  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  def self.storage: () -> (Object & Storage::_Adapter)
  def self.images: () -> (Object & Images::_Adapter)
  def self.ci: () -> (Object & CI::_Adapter)
  def self.access_policy: () -> (Object & AccessPolicy::_Policy)
  def self.scm: () -> (Object & Scm::_Adapter)
end
