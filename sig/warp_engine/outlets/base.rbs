module WarpEngine
  module Outlets
    # The base of every outlet type; a host registers its own with
    # +register_outlet_type+.
    class Base
      def self.type_name: () -> String
      def self.materialized?: () -> bool
      def self.served?: () -> bool
      def self.validate_all!: (Array[Base] outlets) -> Array[Base]

      attr_reader key: String
      attr_reader options: Hash[Symbol, untyped]

      def initialize: (String | Symbol key, ?Hash[untyped, untyped] options) -> void
      def type: () -> String
      def platforms: () -> Array[String]
      # A WarpEngine::Catalog::Offer, or +nil+ for an outlet that decides per caller.
      def offer: () -> untyped
      def validate!: () -> self
      def descriptor: () -> Hash[Symbol, untyped]
      def describe: () -> String
      def report: () -> Array[String]

      private

      def option_list: (Symbol name) -> Array[String]
      def check_keys!: (Array[Symbol] allowed) -> void
      def check_platforms!: (Array[String] names) -> void
      def check_kinds!: (Array[String] names) -> void
    end

    # The result of Materialized#sync!.
    interface _SyncResult
      def changed?: () -> boolish
      def lines: () -> Array[String]
    end

    # An outlet that writes files.
    module Materialized : Base
      def self.included: (Class base) -> void
      def sync!: (?dry_run: bool) -> _SyncResult
    end

    # An outlet that answers requests; the class defines <tt>self.draw_routes(mapper)</tt>.
    module Served : Base
      def self.included: (Class base) -> void
      def hosts: () -> Array[String]
      def serves?: (untyped request) -> bool
    end
  end
end
