<%- disk = options["media"] == "d64" -%>
<%# C sources (Oscar64, cc65) under src/ get Doxygen docs (warp_cdoc). -%>
<%- file = disk ? "#{name}.d64" : "#{name}.prg" -%>
steps:
  - name: build
    artifacts: [ "*.prg", "*.d64", "*.metadata.json" ]
    image: <%= builder %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
<%- if options["build"] == "make" || disk -%>
        make <%= file %>
<%- else -%>
        acme -f cbm -o <%= file %> main.asm
<%- end -%>
        echo "==> Creating versioned files for $VERSION"
        cp <%= file %> <%= name %>-$VERSION.<%= disk ? "d64" : "prg" %>
        cp metadata.json <%= name %>-$VERSION.metadata.json
        ls -lh <%= name %>-$VERSION.*
<%- if kinds.include?("docs") -%>

  - name: docs
    artifacts: [ "*-docs.zip" ]
    image: <%= tools || "alpine" %>
    commands:
<%- unless tools -%>
      - W_SETUP='apk add --no-cache doxygen zip >/dev/null'
<%- end -%>
      - warp_cdoc c src '*.c' '*.h'
<%- end -%>
<%- if targets.any? -%>

  - name: package
    artifacts: [ "*.zip" ]
    image: <%= exporter %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
        echo "==> Packaging the native players for $VERSION"
        commodore-pack <%= machine %> <%= name %> $VERSION
<%- end -%>
