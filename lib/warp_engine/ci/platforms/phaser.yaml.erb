steps:
  - name: build
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        VERSION=$(cat .version)
        # Two project forms: plain JS (the sources concatenated, Phaser from
        # the CDN) and a bundled one (Vite + TypeScript) whose build makes the
        # whole web package itself.
        if [ -f package.json ] && grep -q '"build"' package.json; then
          echo "==> Bundled project — npm ci && npm run build"
          npm ci
          npm run build
          # The Vite output is complete: index.html and the hashed assets. The
          # vite.config base must be relative: the game is served from
          # /file/<name>/<version>/html/.
          if [ ! -f dist/index.html ]; then
            echo "ERROR: the build left no dist/index.html" >&2
            exit 1
          fi
          echo "==> Packaging web build for $VERSION"
          (cd dist && zip -r "../<%= name %>-$VERSION.html.zip" .)
          echo "==> Cleaning temporary files"
          rm -rf dist
        else
          echo "==> Checking JS syntax"
          # A bundled project has no src/*.js, and the shell then passes the
          # pattern on literally, which node fails on.
          for f in src/*.js; do [ -e "$f" ] || continue; node --check "$f"; done
          mkdir -p dist/web
          echo "==> Downloading Phaser 3.90.0"
          curl -fsSL https://cdn.jsdelivr.net/npm/phaser@3.90.0/dist/phaser.min.js -o dist/web/phaser.min.js
          echo "==> Downloading index.html"
          <%- if web_shell -%>
          curl -fsSL <%= web_shell %> -o dist/web/index.html
          <%- else -%>
          cp web/index.html dist/web/index.html
          <%- end -%>
          echo "==> Bundling game sources"
          cat src/*.js > dist/web/game.js
          echo "==> Packaging web build for $VERSION"
          (cd dist/web && zip -r "../../<%= name %>-$VERSION.html.zip" .)
          echo "==> Cleaning temporary files"
          rm -rf dist/web
        fi
<%- if kinds.include?("docs") -%>

  - name: docs
    artifacts: [ "*-docs.zip" ]
    image: <%= builder %>
    commands:
      - if [ -f package.json ]; then npm ci --no-audit --no-fund; fi
      - warp_tsdoc
<%- end -%>
