<%- go = if app == "gui"
           { "linux_x64" => [ "linux", "amd64", "1", "" ], "win_x64" => [ "windows", "amd64", "0", ".exe", "", "-H=windowsgui" ],
             "linux_arm64" => [ "linux", "arm64", "1", "", "aarch64-linux-gnu-gcc" ] }
         else
           { "cli_linux_x64" => %w[linux amd64 0], "cli_win_x64" => [ "windows", "amd64", "0", ".exe" ],
             "cli_linux_arm64" => %w[linux arm64 0], "cli_mac_x64" => %w[darwin amd64 0], "cli_mac_arm64" => %w[darwin arm64 0] }
         end -%>
<%- (targets.keys - go.keys).each { |kind| raise ArgumentError, "golang template cannot build #{kind}" } -%>
steps:
  - name: binaries
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        go_build() {
          if [ -n "$5" ]; then export CC="$5"; else unset CC; fi
          CGO_ENABLED="$3" GOOS="$1" GOARCH="$2" go build -trimpath -ldflags "-s -w $6" -o "$PKG_DIR/<%= name %>$4" .
        }
        <%- targets.each do |kind, args| -%>
        warp_target <%= args %> go_build <%= go.fetch(kind).map { |a| "'#{a}'" }.join(" ") %>
        <%- end -%>

  - name: docs
    artifacts: [ "*-docs.zip" ]
    image: <%= builder %>
    commands:
      - warp_godoc
<%- if app == "gui" -%>

  - name: web
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        VERSION=$(cat .version)
        rm -rf web-dist && mkdir -p web-dist
        if ! GOOS=js GOARCH=wasm go build -trimpath -o web-dist/main.wasm .; then
          echo "WARNING: the program does not build for the web, no html asset"
          rm -rf web-dist
          exit 0
        fi
        cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" web-dist/wasm_exec.js
        if [ -f web/index.html ]; then
          cp web/index.html web-dist/index.html
        else
          printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">' \
            '<title><%= name %></title><style>html,body{margin:0;height:100%;background:#000}</style>' \
            '<script src="wasm_exec.js"></script></head><body><script>' \
            'const go = new Go();' \
            'WebAssembly.instantiateStreaming(fetch("main.wasm"), go.importObject).then((r) => go.run(r.instance));' \
            '</script></body></html>' > web-dist/index.html
        fi
        (cd web-dist && zip -r "../<%= name %>-$VERSION.html.zip" . >/dev/null)
        rm -rf web-dist
        echo "==> <%= name %>-$VERSION.html.zip done"
<%- end -%>
