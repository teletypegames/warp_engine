# An Electron app with electron-builder in its devDependencies. The app's own
# "check" script (tests that need no display) and "build" script run first when
# it has them; electron-builder then packages
# the AppImage and the NSIS installer, each zipped under the upload name.
# A dev or other non-semver build version leaves package.json's version in the app.
steps:
  - name: linux
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
        npm ci --no-audit --no-fund
        npm run check --if-present
        npm run build --if-present
        set -- --publish never -c.directories.output=.warp-dist
        if printf '%s' "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
          set -- "$@" -c.extraMetadata.version="$VERSION"
        fi
        npx --no-install electron-builder --linux AppImage --x64 "$@"
        PKG="<%= name %>-$VERSION-linux-x64"
        rm -rf "$PKG" "$PKG.zip" && mkdir -p "$PKG"
        cp .warp-dist/*.AppImage "$PKG/"
        python3 -m zipfile -c "$PKG.zip" "$PKG"
        rm -rf "$PKG" .warp-dist
        echo "==> $PKG.zip ready"

  - name: windows
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
        [ -d node_modules ] || npm ci --no-audit --no-fund
        npm run build --if-present
        set -- --publish never -c.directories.output=.warp-dist
        if printf '%s' "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
          set -- "$@" -c.extraMetadata.version="$VERSION"
        fi
        npx --no-install electron-builder --win nsis --x64 "$@"
        PKG="<%= name %>-$VERSION-win-x64"
        rm -rf "$PKG" "$PKG.zip" && mkdir -p "$PKG"
        cp .warp-dist/*.exe "$PKG/"
        python3 -m zipfile -c "$PKG.zip" "$PKG"
        rm -rf "$PKG" .warp-dist
        echo "==> $PKG.zip ready"
