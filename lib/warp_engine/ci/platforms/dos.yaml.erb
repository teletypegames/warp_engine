steps:
  - name: test
    artifacts: [ "*.EXE", "*.COM" ]
    image: <%= builder %>
    pull: true
    commands:
      - dos-check
      - dos-build
      - dos-test

  - name: package
    artifacts: [ dist/, .release-assets ]
    image: <%= builder %>
    commands:
      - dos-pack

upload:
  packages: [ jq ]
  prepare: |
    TAG="$CI_COMMIT_TAG"
    FOLDER=$(jq -r '.dos.folder // empty' metadata.json)
    WIN32_FOLDER=$(jq -r '.dos.win32_folder // empty' metadata.json)
    if [ -z "$FOLDER" ]; then
      echo "ERROR: no dos.folder in metadata.json!"
      exit 1
    fi
    cp "dist/$FOLDER-$TAG.zip" <%= name %>-$VERSION.zip
    if [ -n "$WIN32_FOLDER" ]; then
      cp "dist/$WIN32_FOLDER-$TAG.zip" <%= name %>-$VERSION-win-x86.zip
    fi
    jq --arg version "$VERSION" '. + {version: $version}' metadata.json > <%= name %>-$VERSION.metadata.json
