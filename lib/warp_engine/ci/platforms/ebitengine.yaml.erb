<%- go = { "win_x86" => %w[windows 386 0 .exe], "win_x64" => %w[windows amd64 0 .exe],
           "linux_x64" => [ "linux", "amd64", "1", "" ], "linux_arm64" => [ "linux", "arm64", "1", "", "aarch64-linux-gnu-gcc" ] } -%>
<%- (targets.keys - go.keys).each { |kind| raise ArgumentError, "ebitengine template cannot build #{kind}" } -%>
steps:
  - name: build
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        VERSION=$(cat .version)
        mkdir -p dist
        GOOS=js GOARCH=wasm go build -o dist/game.wasm .
        cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" dist/wasm_exec.js
        <%- if web_shell -%>
        echo "==> Downloading index.html"
        curl -fsSL <%= web_shell %> -o dist/index.html
        <%- else -%>
        if [ -f web/index.html ]; then
          cp web/index.html dist/index.html
        else
          printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">' \
            '<title><%= name %></title><style>html,body{margin:0;height:100%;background:#000}</style>' \
            '<script src="wasm_exec.js"></script></head><body><script>' \
            'const go = new Go();' \
            'WebAssembly.instantiateStreaming(fetch("game.wasm"), go.importObject).then((r) => go.run(r.instance));' \
            '</script></body></html>' > dist/index.html
        fi
        <%- end -%>
        echo "==> Packaging HTML/WASM for $VERSION"
        zip -r "<%= name %>-$VERSION.html.zip" -j dist/game.wasm dist/wasm_exec.js dist/index.html
        rm -f dist/game.wasm dist/wasm_exec.js dist/index.html

  - name: binaries
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        go_build() {
          if [ -n "$5" ]; then export CC="$5"; else unset CC; fi
          CGO_ENABLED="$3" GOOS="$1" GOARCH="$2" go build -o "$PKG_DIR/<%= name %>$4" .
        }
        <%- targets.each do |kind, args| -%>
        warp_target <%= args %> go_build <%= go.fetch(kind).map { |a| "'#{a}'" }.join(" ") %>
        <%- end -%>
