<%- rust = { "linux_x64" => [ "", "" ],
             "win_x64" => [ "x86_64-pc-windows-gnu", ".exe" ],
             "linux_arm64" => [ "aarch64-unknown-linux-gnu", "" ] } -%>
<%- (targets.keys - rust.keys).each { |kind| raise ArgumentError, "bevy template cannot build #{kind}" } -%>
steps:
  - name: build
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        VERSION=$(cat .version)
        mkdir -p dist
        cargo build --release --target wasm32-unknown-unknown
        wasm-bindgen --target web --no-typescript \
          --out-dir dist --out-name game target/wasm32-unknown-unknown/release/<%= name %>.wasm
        <%- if web_shell -%>
        echo "==> Downloading index.html"
        curl -fsSL <%= web_shell %> -o dist/index.html
        <%- else -%>
        if [ -f web/index.html ]; then
          cp web/index.html dist/index.html
        else
          printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">' \
            '<title><%= name %></title><style>html,body{margin:0;height:100%;background:#000}</style></head><body>' \
            '<script type="module">import init from "./game.js"; init();</script>' \
            '</body></html>' > dist/index.html
        fi
        <%- end -%>
        echo "==> Packaging HTML/WASM for $VERSION"
        zip -r "<%= name %>-$VERSION.html.zip" -j dist/game_bg.wasm dist/game.js dist/index.html
        rm -f dist/game_bg.wasm dist/game.js dist/index.html

  - name: binaries
    artifacts: [ "*.zip" ]
    image: <%= builder %>
    commands:
      - |
        cargo_build() {
          case "$1" in
            "")
              cargo build --release
              cp "target/release/<%= name %>$2" "$PKG_DIR/" ;;
            x86_64-pc-windows-gnu)
              CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc cargo build --release --target "$1"
              cp "target/$1/release/<%= name %>$2" "$PKG_DIR/" ;;
            aarch64-unknown-linux-gnu)
              PKG_CONFIG_ALLOW_CROSS=1 PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
                CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc cargo build --release --target "$1"
              cp "target/$1/release/<%= name %>$2" "$PKG_DIR/" ;;
          esac
          chmod +x "$PKG_DIR/<%= name %>$2"
          if [ -d assets ]; then cp -r assets "$PKG_DIR/assets"; fi
        }
        <%- targets.each do |kind, args| -%>
        warp_target <%= args %> cargo_build <%= rust.fetch(kind).map { |a| "'#{a}'" }.join(" ") %>
        <%- end -%>
