# Generated pipeline — WarpEngine /build/config (platform: dos, name: <%= name %>)
steps:
  - name: test
    image: <%= builder %>
    pull: true
    commands:
      - dos-check
      - dos-build
      - dos-test

  - name: package
    image: <%= builder %>
    commands:
      - TAG="${CI_COMMIT_TAG:-v$(cat .version)}" dos-pack

  - name: upload
    image: <%= tools || "alpine" %>
    environment:
      UPDATE_SERVER: <%= update_server %>
      UPDATE_SECRET:
        from_secret: application_token
    commands:
<%- unless tools -%>
      - apk add --no-cache curl jq
<%- end -%>
      - |
        VERSION=$(cat .version)
        TAG="${CI_COMMIT_TAG:-v$VERSION}"
        FOLDER=$(jq -r '.dos.folder // empty' metadata.json)
        WIN32_FOLDER=$(jq -r '.dos.win32_folder // empty' metadata.json)
        if [ -z "$FOLDER" ]; then
          echo "ERROR: no dos.folder in metadata.json!"
          exit 1
        fi
        cp "dist/$FOLDER-$TAG.zip" <%= name %>-$VERSION.zip
        FILES="<%= name %>-$VERSION.zip <%= name %>-$VERSION.metadata.json"
        if [ -n "$WIN32_FOLDER" ]; then
          cp "dist/$WIN32_FOLDER-$TAG.zip" <%= name %>-$VERSION-win-x86.zip
          FILES="$FILES <%= name %>-$VERSION-win-x86.zip"
        fi
        jq --arg version "$VERSION" '. + {version: $version}' metadata.json > <%= name %>-$VERSION.metadata.json
        echo "==> Uploading $FILES"
        for f in $FILES; do
          curl -fsS -H "X-Update-Secret: $UPDATE_SECRET" \
            -F "file=@$f" \
            "$UPDATE_SERVER/build/upload?name=<%= name %>&version=$VERSION" || exit 1
        done

  - name: publish
    image: <%= tools || "alpine" %>
    environment:
      UPDATE_SERVER: <%= update_server %>
      UPDATE_SECRET:
        from_secret: application_token
    commands:
<%- unless tools -%>
      - apk add --no-cache curl
<%- end -%>
      - |
        VERSION=$(cat .version)
        echo "==> Publishing version $VERSION"
        curl -fsS -X POST -H "X-Update-Secret: $UPDATE_SECRET" "$UPDATE_SERVER/build/publish?name=<%= name %>&platform=dos&version=$VERSION"
