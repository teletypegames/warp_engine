# Generated pipeline — WarpEngine /build/config (platform: plus4, name: <%= name %>)
steps:
  - name: build
    image: <%= builder %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
<%- if options["build"] == "make" -%>
        make <%= name %>.prg
<%- else -%>
        acme -f cbm -o <%= name %>.prg main.asm
<%- end -%>
        echo "==> Creating versioned files for $VERSION"
        cp <%= name %>.prg <%= name %>-$VERSION.prg
        cp metadata.json <%= name %>-$VERSION.metadata.json
        ls -lh <%= name %>-$VERSION.*

  - name: package
    image: <%= exporter %>
    pull: true
    commands:
      - |
        VERSION=$(cat .version)
        echo "==> Packaging the browser and native players for $VERSION"
        commodore-pack plus4 <%= name %> $VERSION

  - name: upload
    image: <%= tools || "alpine" %>
    environment:
      UPDATE_SERVER: <%= update_server %>
      UPDATE_SECRET:
        from_secret: application_token
    commands:
<%- unless tools -%>
      - apk add --no-cache curl
<%- end -%>
      - |
        VERSION=$(cat .version)
        echo "==> Uploading artifacts for version $VERSION"
        FILES="<%= name %>-$VERSION.prg <%= name %>-$VERSION.metadata.json"
        for f in <%= name %>-$VERSION.html.zip <%= name %>-$VERSION-linux-x64.zip \
                 <%= name %>-$VERSION-win-x64.zip <%= name %>-$VERSION-mac-arm64.zip; do
          if [ -f "$f" ]; then FILES="$FILES $f"; fi
        done
        for f in $FILES; do
          curl -fsS -H "X-Update-Secret: $UPDATE_SECRET" \
            -F "file=@$f" \
            "$UPDATE_SERVER/build/upload?name=<%= name %>&version=$VERSION" || exit 1
        done

  - name: publish
    image: <%= tools || "alpine" %>
    environment:
      UPDATE_SERVER: <%= update_server %>
      UPDATE_SECRET:
        from_secret: application_token
    commands:
<%- unless tools -%>
      - apk add --no-cache curl
<%- end -%>
      - |
        VERSION=$(cat .version)
        echo "==> Publishing version $VERSION"
        curl -fsS -X POST -H "X-Update-Secret: $UPDATE_SECRET" "$UPDATE_SERVER/build/publish?name=<%= name %>&platform=plus4&version=$VERSION"
