<%
  icons = {
    "ok" => "M20 6 9 17l-5-5",
    "warn" => "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z",
    "error" => "M18 6 6 18M6 6l12 12",
    "off" => "M5 12h14",
    "info" => "M12 16v-4M12 8h.01M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z"
  }
  group_icons = {
    engine: "M6 4h12v16H6zM9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3",
    key: "M15.5 7.5 19 4l3 3-3.5 3.5M11.4 11.6a5.5 5.5 0 1 1-7.8 7.8 5.5 5.5 0 0 1 7.8-7.8zM11.4 11.6 15.5 7.5",
    plug: "M12 22v-5M9 8V2M15 8V2M18 8v5a6 6 0 0 1-12 0V8z",
    user: "M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10z",
    branch: "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9",
    gamepad: "M6 12h4M8 10v4M15 13h.01M18 11h.01M17.3 5H6.7a4 4 0 0 0-4 3.6L2 15a3 3 0 0 0 5.2 2.2L9 15h6l1.8 2.2A3 3 0 0 0 22 15l-.7-6.4A4 4 0 0 0 17.3 5z",
    send: "M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z",
    terminal: "M4 17l6-6-6-6M12 19h8",
    plus: "M12 8v8M8 12h8M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
  }
  words = { "ok" => "OK", "warn" => "Check", "error" => "Problem", "off" => "Off", "info" => "Info" }
  counts = sys_info.counts
  cards = [
    [ "Problems", counts["error"], "error", "need fixing", true ],
    [ "To check", counts["warn"], "warn", "work, with a catch", true ],
    [ "Healthy", counts["ok"], "ok", "settings and checks", false ],
    [ "Off", counts["off"], "off", "switched off on purpose", false ]
  ]
%>
<div class="we-si" id="we-sysinfo">
  <style>
    .we-si{--we-page:#fff;--we-surface:#fafafa;--we-raised:#f4f4f5;--we-line:#e4e4e7;--we-line-strong:#d4d4d8;--we-fg:#18181b;--we-muted:#52525b;--we-subtle:#71717a;--we-accent:#15803d;--we-ok:#15803d;--we-ok-bg:#dcfce7;--we-warn:#b45309;--we-warn-bg:#fef3c7;--we-err:#b91c1c;--we-err-bg:#fee2e2;--we-off:#71717a;--we-off-bg:#f4f4f5;--we-info:#1d4ed8;--we-info-bg:#dbeafe;color:var(--we-fg);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px;line-height:1.45;display:flex;flex-direction:column;gap:18px;max-width:1180px}
    .we-si *{box-sizing:border-box}
    .we-si button{text-shadow:none !important;background-image:none;box-shadow:none;-webkit-font-smoothing:auto;letter-spacing:normal;text-transform:none}
    .we-si-intro{margin:0;color:var(--we-muted);max-width:720px}
    .we-si-mono{font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;overflow-wrap:anywhere}
    .we-si-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    .we-si-ok{color:var(--we-ok)}.we-si-warn{color:var(--we-warn)}.we-si-error{color:var(--we-err)}.we-si-off{color:var(--we-off)}.we-si-info{color:var(--we-info)}
    .we-si-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
    .we-si-card{font-family:inherit !important;font-weight:400 !important;letter-spacing:normal;text-transform:none;background:var(--we-surface);border:1px solid var(--we-line);border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;gap:4px;min-width:0;text-align:left;font:inherit;color:inherit}
    button.we-si-card{cursor:pointer}
    button.we-si-card:hover{border-color:var(--we-line-strong)}
    button.we-si-card[aria-pressed="true"]{outline:2px solid var(--we-accent);outline-offset:-1px}
    .we-si-card-k{font-size:11.5px;color:var(--we-subtle);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
    .we-si-card-v{font-size:24px;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
    .we-si-card-s{font-size:12px;color:var(--we-muted)}
    .we-si-tools{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:10px;border:1px solid var(--we-line);border-radius:12px;background:var(--we-surface)}
    .we-si-search{position:relative;display:flex;align-items:center}
    .we-si-search svg{position:absolute;left:11px;color:var(--we-subtle)}
    .we-si-search input{min-height:36px;width:270px;max-width:100%;padding:0 12px 0 34px !important;border-radius:8px;border:1px solid var(--we-line-strong);background:var(--we-page);color:var(--we-fg);font:inherit;font-size:13px}
    .we-si-btn{font-family:inherit !important;text-shadow:none;display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;border-radius:8px;border:1px solid var(--we-line-strong);background:var(--we-page);color:var(--we-fg) !important;font:inherit;font-size:13px;font-weight:500;cursor:pointer;text-decoration:none !important}
    .we-si-btn:hover{background:var(--we-raised)}
    .we-si-seg{display:inline-flex;border:1px solid var(--we-line-strong);border-radius:8px;overflow:hidden}
    .we-si-seg button{font-family:inherit !important;text-shadow:none;min-height:34px;padding:0 12px;border:0;background:var(--we-page);color:var(--we-muted);font:inherit;font-size:13px;font-weight:500;cursor:pointer}
    .we-si-seg button[aria-pressed="true"]{background:var(--we-fg);color:var(--we-page)}
    .we-si-switch{display:inline-flex;align-items:center;gap:10px;min-height:36px;color:var(--we-fg) !important;font-size:13px;font-weight:500;text-decoration:none !important}
    .we-si-switch[aria-disabled="true"]{opacity:.55;pointer-events:none}
    .we-si-track{width:36px;height:20px;border-radius:999px;background:var(--we-line-strong);position:relative}
    .we-si-track.on{background:var(--we-accent)}
    .we-si-knob{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:left .15s}
    .we-si-track.on .we-si-knob{left:18px}
    .we-si-spacer{flex-grow:1}
    .we-si-time{color:var(--we-subtle)}
    .we-si-groups{display:flex;flex-direction:column;gap:10px}
    .we-si-group{border:1px solid var(--we-line);border-radius:12px;background:var(--we-surface);overflow:hidden;position:relative}
    .we-si-group::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--we-ok)}
    .we-si-group[data-status="warn"]::before{background:var(--we-warn)}.we-si-group[data-status="error"]::before{background:var(--we-err)}.we-si-group[data-status="off"]::before{background:var(--we-line-strong)}.we-si-group[data-status="info"]::before{background:var(--we-info)}
    .we-si-group>summary{display:flex;align-items:center;gap:12px;padding:14px 16px 14px 20px;cursor:pointer;list-style:none}
    .we-si-group>summary::-webkit-details-marker,.we-si-branch>summary::-webkit-details-marker{display:none}
    .we-si-group>summary:hover{background:var(--we-raised)}
    .we-si-gicon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:none;background:var(--we-raised);color:var(--we-fg)}
    .we-si-group[data-status="ok"] .we-si-gicon{background:var(--we-ok-bg);color:var(--we-ok)}.we-si-group[data-status="warn"] .we-si-gicon{background:var(--we-warn-bg);color:var(--we-warn)}.we-si-group[data-status="error"] .we-si-gicon{background:var(--we-err-bg);color:var(--we-err)}.we-si-group[data-status="info"] .we-si-gicon{background:var(--we-info-bg);color:var(--we-info)}
    .we-si-gtext{display:flex;flex-direction:column;gap:1px;min-width:0;flex-grow:1}
    .we-si-gtitle{font-size:15px;font-weight:600}
    .we-si-gintro{font-size:12.5px;color:var(--we-muted)}
    .we-si-tally{font-family:"JetBrains Mono",ui-monospace,monospace;color:var(--we-subtle);font-size:12px;white-space:nowrap}
    .we-si-pill{display:inline-flex;align-items:center;gap:6px;padding:2px 10px 2px 7px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap}
    .we-si-pill.we-si-ok{background:var(--we-ok-bg)}.we-si-pill.we-si-warn{background:var(--we-warn-bg)}.we-si-pill.we-si-error{background:var(--we-err-bg)}.we-si-pill.we-si-off{background:var(--we-off-bg)}.we-si-pill.we-si-info{background:var(--we-info-bg)}
    .we-si-chev{transition:transform .18s ease;flex:none;color:var(--we-subtle)}
    details[open]>summary>.we-si-chev,details[open]>summary .we-si-label>.we-si-chev{transform:rotate(90deg)}
    .we-si-body{border-top:1px solid var(--we-line);background:var(--we-page)}
    details[open]>.we-si-body,details[open]>.we-si-kids{animation:we-si-slide .18s ease}
    @keyframes we-si-slide{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
    .we-si-line{display:grid;grid-template-columns:22px minmax(150px,240px) minmax(0,1fr) auto;gap:12px;align-items:start;padding:10px 16px 10px 20px}
    .we-si-body>.we-si-row,.we-si-kids>.we-si-row{border-bottom:1px solid var(--we-line)}
    .we-si-body>.we-si-row:last-child,.we-si-kids>.we-si-row:last-child{border-bottom:0}
    .we-si-branch>summary{cursor:pointer;list-style:none}
    .we-si-branch>summary:hover{background:var(--we-surface)}
    .we-si-st{padding-top:2px;position:relative}
    .we-si-label{font-weight:500;display:flex;align-items:center;gap:6px;overflow-wrap:anywhere}
    .we-si-value{display:flex;flex-wrap:wrap;gap:6px;align-items:center;min-width:0}
    .we-si-chip{display:inline-block;padding:1px 8px;border-radius:6px;background:var(--we-raised);border:1px solid var(--we-line);font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;color:var(--we-fg);overflow-wrap:anywhere}
    .we-si-hint{grid-column:3 / 5;font-size:12px;color:var(--we-muted)}
    .we-si-kids{background:var(--we-surface);border-top:1px dashed var(--we-line)}
    .we-si-kids .we-si-line{padding-left:48px}
    .we-si-kids .we-si-kids .we-si-line{padding-left:76px}
    .we-si-empty{padding:28px;text-align:center;color:var(--we-muted);border:1px dashed var(--we-line-strong);border-radius:12px}
    .we-si-foot{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:12px;color:var(--we-subtle);border-top:1px solid var(--we-line);padding-top:14px}
    .we-si [hidden]{display:none !important}
    @media (max-width:760px){.we-si-line{grid-template-columns:22px minmax(0,1fr)}.we-si-value,.we-si-hint{grid-column:2 / 3}.we-si-tally{display:none}}
  </style>

  <p class="we-si-intro">The engine as it runs now: the host's configuration, what follows from it, and live checks against the services it depends on. Secrets only show whether they are set.</p>

  <section class="we-si-grid" aria-label="Health">
    <% cards.each do |label, count, status, detail, filters| %>
      <% if filters %>
        <button type="button" class="we-si-card" data-filter-problems aria-pressed="false">
      <% else %>
        <div class="we-si-card">
      <% end %>
        <span class="we-si-card-k"><%= label %></span>
        <span class="we-si-card-v we-si-<%= status %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons.fetch(status) %>"></path></svg><%= count %></span>
        <span class="we-si-card-s"><%= detail %></span>
      <%= filters ? raw("</button>") : raw("</div>") %>
    <% end %>
  </section>

  <section class="we-si-grid" aria-label="Catalog">
    <div class="we-si-card"><span class="we-si-card-k">Engine</span><span class="we-si-card-v"><%= WarpEngine::VERSION %></span><span class="we-si-card-s">catalog API v<%= WarpEngine::API_VERSION %><%= " · Admin API v#{WarpEngine::AdminApi::VERSION}" if WarpEngine.config.admin_api.enabled? %></span></div>
    <% sys_info.stats.each do |stat| %>
      <div class="we-si-card"><span class="we-si-card-k"><%= stat.label %></span><span class="we-si-card-v"><%= stat.value %></span><span class="we-si-card-s"><%= stat.detail %></span></div>
    <% end %>
  </section>

  <section class="we-si-tools" aria-label="Tools">
    <div class="we-si-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 21l-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"></path></svg>
      <label for="we-si-search" class="we-si-sr">Search settings</label>
      <input id="we-si-search" type="search" placeholder="Search settings, values, keys…" autocomplete="off">
    </div>
    <div class="we-si-seg" role="group" aria-label="Show">
      <button type="button" data-show="all" aria-pressed="true">All</button>
      <button type="button" data-show="problems" aria-pressed="false">Problems only</button>
    </div>
    <button type="button" class="we-si-btn" data-expand="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"></path></svg>Expand all</button>
    <button type="button" class="we-si-btn" data-expand="false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 20 5-5 5 5M7 4l5 5 5-5"></path></svg>Collapse all</button>
    <span class="we-si-spacer"></span>
    <a class="we-si-switch" href="<%= request.path %>?live=<%= sys_info.live? ? 0 : 1 %>" role="switch" aria-checked="<%= sys_info.live? %>"<%= ' aria-disabled="true" title="Turned off with sys_info_live_checks false, or no CI server to ask"'.html_safe unless sys_info.live_available? %>>
      <span class="we-si-track<%= ' on' if sys_info.live? %>"><span class="we-si-knob"></span></span>Live checks
    </a>
    <a class="we-si-btn" href="<%= request.path %>?live=1"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"></path></svg>Run checks</a>
    <span class="we-si-mono we-si-time"><%= sys_info.live? ? "checked #{sys_info.checked_at.strftime('%H:%M:%S')}" : "live checks off" %></span>
  </section>

  <section class="we-si-groups" aria-label="Configuration tree">
    <% sys_info.tree.each do |group| %>
      <% status = group.rolled_status %>
      <details class="we-si-group we-si-row" data-key="<%= group.key %>" data-status="<%= status %>" data-search="<%= [ group.label, group.intro ].join(' ').downcase %>"<%= " open" if group.problem? %>>
        <summary>
          <svg class="we-si-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          <span class="we-si-gicon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= group_icons.fetch(group.icon) %>"></path></svg></span>
          <span class="we-si-gtext"><span class="we-si-gtitle"><%= group.label %></span><span class="we-si-gintro"><%= group.intro %></span></span>
          <span class="we-si-tally"><%= group.tally %></span>
          <span class="we-si-pill we-si-<%= status %>"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons.fetch(status) %>"></path></svg><%= words.fetch(status) %></span>
        </summary>
        <div class="we-si-body">
          <% group.children.each do |child| %>
            <%= render "warp_engine/admin/sys_info_node", node: child, icons: icons %>
          <% end %>
        </div>
      </details>
    <% end %>
    <div class="we-si-empty" data-empty hidden>Nothing matches. Clear the search or show all.</div>
  </section>

  <footer class="we-si-foot">
    <span>Computed on every load from WarpEngine.config.</span>
    <span>Live checks call the CI server; the host turns them off for good with <span class="we-si-chip">sys_info_live_checks false</span>.</span>
  </footer>

  <script>
    (function () {
      var root = document.getElementById("we-sysinfo");
      if (!root) return;
      var storeKey = "warp_engine.sysinfo.open";
      var search = root.querySelector("#we-si-search");
      var problems = false;
      var all = function (selector) { return Array.prototype.slice.call(root.querySelectorAll(selector)); };
      var bad = function (el) { var s = el.getAttribute("data-status"); return s === "error" || s === "warn"; };

      var saved = {};
      try { saved = JSON.parse(window.localStorage.getItem(storeKey) || "{}") || {}; } catch (e) { saved = {}; }
      all("details[data-key]").forEach(function (d) {
        var key = d.getAttribute("data-key");
        if (key in saved && !bad(d)) d.open = saved[key];
        d.addEventListener("toggle", function () {
          saved[key] = d.open;
          try { window.localStorage.setItem(storeKey, JSON.stringify(saved)); } catch (e) {}
        });
      });

      var apply = function () {
        var q = (search.value || "").trim().toLowerCase();
        var shown = 0;
        var visit = function (row, inherited) {
          var hit = !q || inherited || (row.getAttribute("data-search") || "").indexOf(q) !== -1;
          var box = row.matches("details") ? row.querySelector(":scope > .we-si-kids, :scope > .we-si-body") : null;
          var kids = box ? Array.prototype.filter.call(box.children, function (kid) { return kid.classList.contains("we-si-row"); }) : [];
          if (!kids.length) {
            var leaf = hit && (!problems || bad(row));
            row.hidden = !leaf;
            return leaf;
          }
          var any = false;
          kids.forEach(function (kid) { if (visit(kid, q !== "" && hit)) any = true; });
          if (any && (q || problems)) row.open = true;
          row.hidden = !any;
          return any;
        };
        all(".we-si-group").forEach(function (group) { if (visit(group, false)) shown += 1; });
        root.querySelector("[data-empty]").hidden = shown > 0;
        all("[data-show]").forEach(function (b) { b.setAttribute("aria-pressed", String((b.getAttribute("data-show") === "problems") === problems)); });
        all("[data-filter-problems]").forEach(function (b) { b.setAttribute("aria-pressed", String(problems)); });
      };

      search.addEventListener("input", apply);
      all("[data-show]").forEach(function (b) { b.addEventListener("click", function () { problems = b.getAttribute("data-show") === "problems"; apply(); }); });
      all("[data-filter-problems]").forEach(function (b) { b.addEventListener("click", function () { problems = !problems; apply(); }); });
      all("[data-expand]").forEach(function (b) {
        b.addEventListener("click", function () {
          var open = b.getAttribute("data-expand") === "true";
          all("details[data-key]").forEach(function (d) { d.open = open; });
        });
      });
    })();
  </script>
</div>
