<% status = node.rolled_status %>
<% search = [ node.label, node.value, *node.chips, node.hint ].compact.join(" ").downcase %>
<% if node.branch? %>
  <details class="we-si-row we-si-branch" data-key="<%= node.key %>" data-status="<%= status %>" data-search="<%= search %>"<%= " open" if node.problem? %>>
    <summary class="we-si-line">
      <span class="we-si-st we-si-<%= status %>"><%= WarpEngine::AdminIcons.svg(status, stroke: 2.6) %><span class="we-si-sr"><%= status %></span></span>
      <span class="we-si-label"><%= WarpEngine::AdminIcons.svg(:chevron, size: 14, css_class: "we-si-chev", stroke: 2.4) %><%= node.label %></span>
      <span class="we-si-value"><% if node.value.present? %><span class="<%= 'we-si-mono' if node.mono %>"><%= node.value %></span><% end %><% node.chips.each do |chip| %><span class="we-si-chip"><%= chip %></span><% end %></span>
      <span class="we-si-tally"><%= node.tally %></span>
    </summary>
    <div class="we-si-kids">
      <% node.children.each do |child| %>
        <%= render "warp_engine/admin/sys_info_node", node: child %>
      <% end %>
    </div>
  </details>
<% else %>
  <div class="we-si-row we-si-line" data-key="<%= node.key %>" data-status="<%= status %>" data-search="<%= search %>">
    <span class="we-si-st we-si-<%= status %>"><%= WarpEngine::AdminIcons.svg(status, stroke: 2.6) %><span class="we-si-sr"><%= status %></span></span>
    <span class="we-si-label"><%= node.label %></span>
    <span class="we-si-value"><% if node.value.present? %><span class="<%= 'we-si-mono' if node.mono %>"><%= node.value %></span><% end %><% node.chips.each do |chip| %><span class="we-si-chip"><%= chip %></span><% end %><% node.links.each do |link| %><% href = link[:href] || (respond_to?(:warp_engine) && link[:route] ? warp_engine.public_send(link[:route]) : nil) %><% if href %><a class="we-si-link" href="<%= href %>" target="_blank" rel="noopener"><%= WarpEngine::AdminIcons.svg(:external, size: 13) %><%= link[:label] %></a><% end %><% end %></span>
    <span></span>
    <% if node.hint.present? %><span class="we-si-hint"><%= node.hint %></span><% end %>
  </div>
<% end %>
