<% status = node.rolled_status %>
<% search = [ node.label, node.value, *node.chips, node.hint ].compact.join(" ").downcase %>
<% if node.branch? %>
  <details class="we-si-row we-si-branch" data-key="<%= node.key %>" data-status="<%= status %>" data-search="<%= search %>"<%= " open" if node.problem? %>>
    <summary class="we-si-line">
      <span class="we-si-st we-si-<%= status %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons.fetch(status) %>"></path></svg><span class="we-si-sr"><%= status %></span></span>
      <span class="we-si-label"><svg class="we-si-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><%= node.label %></span>
      <span class="we-si-value"><% if node.value.present? %><span class="<%= 'we-si-mono' if node.mono %>"><%= node.value %></span><% end %><% node.chips.each do |chip| %><span class="we-si-chip"><%= chip %></span><% end %></span>
      <span class="we-si-tally"><%= node.tally %></span>
    </summary>
    <div class="we-si-kids">
      <% node.children.each do |child| %>
        <%= render "warp_engine/admin/sys_info_node", node: child, icons: icons %>
      <% end %>
    </div>
  </details>
<% else %>
  <div class="we-si-row we-si-line" data-key="<%= node.key %>" data-status="<%= status %>" data-search="<%= search %>">
    <span class="we-si-st we-si-<%= status %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons.fetch(status) %>"></path></svg><span class="we-si-sr"><%= status %></span></span>
    <span class="we-si-label"><%= node.label %></span>
    <span class="we-si-value"><% if node.value.present? %><span class="<%= 'we-si-mono' if node.mono %>"><%= node.value %></span><% end %><% node.chips.each do |chip| %><span class="we-si-chip"><%= chip %></span><% end %></span>
    <span></span>
    <% if node.hint.present? %><span class="we-si-hint"><%= node.hint %></span><% end %>
  </div>
<% end %>
