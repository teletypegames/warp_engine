<%
  type_cell = lambda do |field|
    label = ERB::Util.h(field.type)
    if field.ref
      anchor = WarpEngine::ApiReference.schema_anchor(field.ref)
      label = label.sub(ERB::Util.h(field.ref), %(<a href="##{anchor}" data-ar-schema="#{anchor}">#{ERB::Util.h(field.ref)}</a>))
    end
    label += %( <span class="we-ar-null">| null</span>) if field.nullable
    label.html_safe
  end
%>
<details class="we-si-ref we-ar" id="we-si-api-ref">
  <style>
    .we-ar .we-ar-wrap{display:flex;flex-direction:column;gap:14px;padding:16px 20px 20px}
    .we-ar-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 12px}
    .we-ar-title{font-size:18px;font-weight:700;margin:0}
    .we-ar-badge{font-family:var(--we-mono);font-size:11.5px;padding:1px 8px;border-radius:999px;border:1px solid var(--we-line-strong);color:var(--we-muted)}
    .we-ar-desc{margin:0;color:var(--we-muted);max-width:820px}
    .we-ar-base{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-size:12.5px;color:var(--we-muted)}
    .we-ar-base code,.we-ar code{font-family:var(--we-mono);font-size:12.5px;background:var(--we-raised);border:1px solid var(--we-line);border-radius:4px;padding:1px 6px;color:var(--we-fg)}
    .we-ar-tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
    .we-ar-filter{position:relative;display:flex;align-items:center;flex:1 1 260px;max-width:420px}
    .we-ar-filter svg{position:absolute;left:10px;color:var(--we-subtle)}
    .we-ar-filter input{width:100%;padding:7px 10px 7px 32px;border:1px solid var(--we-line-strong);border-radius:6px;background:var(--we-page);color:var(--we-fg);font-size:13px}
    .we-ar-count{font-family:var(--we-mono);font-size:12px;color:var(--we-subtle)}
    .we-ar-group{display:flex;flex-direction:column;gap:6px}
    .we-ar-gname{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--we-subtle);margin:6px 0 2px;display:flex;gap:8px;align-items:baseline}
    .we-ar-op{border:1px solid var(--we-line);border-radius:8px;background:var(--we-page);overflow:hidden}
    .we-ar-op[open]{border-color:var(--we-line-strong)}
    .we-ar-op>summary{display:grid;grid-template-columns:70px minmax(0,auto) minmax(0,1fr) auto;gap:12px;align-items:center;padding:8px 12px;cursor:pointer;list-style:none}
    .we-ar-op>summary::-webkit-details-marker{display:none}
    .we-ar-op>summary:hover{background:var(--we-surface)}
    .we-ar-verb{font-family:var(--we-mono);font-size:11.5px;font-weight:700;text-transform:uppercase;text-align:center;padding:3px 0;border-radius:5px;background:var(--we-raised);color:var(--we-fg)}
    .we-ar-get{background:var(--we-info-bg);color:var(--we-info)}
    .we-ar-post{background:var(--we-ok-bg);color:var(--we-ok)}
    .we-ar-patch,.we-ar-put{background:var(--we-warn-bg);color:var(--we-warn)}
    .we-ar-delete{background:var(--we-err-bg);color:var(--we-err)}
    .we-ar-path{font-family:var(--we-mono);font-size:13px;overflow-wrap:anywhere}
    .we-ar-path i{font-style:normal;color:var(--we-accent)}
    .we-ar-sum{color:var(--we-muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .we-ar-scope{font-family:var(--we-mono);font-size:11.5px;color:var(--we-subtle);white-space:nowrap}
    .we-ar-body{border-top:1px solid var(--we-line);padding:12px 14px;display:flex;flex-direction:column;gap:12px;background:var(--we-surface)}
    .we-ar-h{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--we-subtle);margin:0 0 4px}
    .we-ar-h span{text-transform:none;letter-spacing:normal;margin-left:6px}
    .we-ar-table{width:100%;border-collapse:collapse;font-size:13px}
    .we-ar-table th{text-align:left;font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--we-muted);padding:5px 8px;border-bottom:1px solid var(--we-line-strong);background:transparent}
    .we-ar-table td{padding:6px 8px;border-bottom:1px solid var(--we-line);vertical-align:top;background:transparent}
    .we-ar-table tr:last-child td{border-bottom:0}
    .we-ar-name{font-family:var(--we-mono);font-size:12.5px;white-space:nowrap}
    .we-ar-req{color:var(--we-err);font-size:11px;font-weight:600;margin-left:4px}
    .we-ar-type{font-family:var(--we-mono);font-size:12px;color:var(--we-muted);white-space:nowrap}
    .we-ar-type a,.we-ar a[data-ar-schema]{color:var(--we-accent);text-decoration:none}
    .we-ar-type a:hover{text-decoration:underline}
    .we-ar-null{color:var(--we-subtle)}
    .we-ar-note{display:block;font-size:12px;color:var(--we-subtle);margin-top:2px}
    .we-ar-codes{display:flex;flex-wrap:wrap;gap:6px}
    .we-ar-code{font-family:var(--we-mono);font-size:12px;padding:1px 7px;border-radius:5px;border:1px solid var(--we-line);background:var(--we-page);color:var(--we-muted)}
    .we-ar-code b{color:var(--we-fg);font-weight:600}
    .we-ar-ok b{color:var(--we-ok)}
    .we-ar-curl{display:flex;gap:8px;align-items:flex-start}
    .we-ar-curl pre{flex:1;margin:0;padding:8px 10px;border-radius:6px;background:var(--we-page);border:1px solid var(--we-line);font-family:var(--we-mono);font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--we-fg)}
    .we-ar-copy{font-size:12px;padding:5px 10px;border-radius:6px;border:1px solid var(--we-line-strong);background:var(--we-page);color:var(--we-fg);cursor:pointer;text-shadow:none;background-image:none;box-shadow:none}
    .we-ar-schemas>summary{cursor:pointer;list-style:none;font-weight:600;padding:8px 0}
    .we-ar-schemas>summary::-webkit-details-marker{display:none}
    .we-ar-schema{border:1px solid var(--we-line);border-radius:8px;background:var(--we-page);margin-top:6px}
    .we-ar-schema>summary{cursor:pointer;list-style:none;padding:7px 12px;font-family:var(--we-mono);font-size:13px}
    .we-ar-schema>summary::-webkit-details-marker{display:none}
    .we-ar-schema>div{border-top:1px solid var(--we-line);padding:8px 12px;background:var(--we-surface)}
    .we-ar-flash{outline:2px solid var(--we-accent);outline-offset:2px}
    @media (max-width:760px){.we-ar-op>summary{grid-template-columns:60px minmax(0,1fr)}.we-ar-sum,.we-ar-scope{display:none}}
  </style>
  <summary>
    <%= WarpEngine::AdminIcons.svg(:chevron, size: 18, css_class: "we-si-chev", stroke: 2.2) %>
    <span class="we-si-gicon"><%= WarpEngine::AdminIcons.svg(:terminal, size: 18) %></span>
    <span class="we-si-gtext"><span class="we-si-gtitle">Admin API reference</span><span class="we-si-gintro"><%= reference.operation_count %> operations in <%= reference.groups.size %> groups, read from the OpenAPI document</span></span>
  </summary>
  <div class="we-si-body">
    <div class="we-si-ref-tools">
      <a class="we-si-link" href="<%= warp_engine.api_admin_openapi_path %>" target="_blank" rel="noopener"><%= WarpEngine::AdminIcons.svg(:external, size: 13) %>openapi.json</a>
      <a class="we-si-link" href="<%= warp_engine.api_admin_openapi_yaml_path %>" target="_blank" rel="noopener"><%= WarpEngine::AdminIcons.svg(:external, size: 13) %>openapi.yaml</a>
      <% if admin_api.docs_ui? %><a class="we-si-link" href="<%= warp_engine.api_admin_docs_path %>" target="_blank" rel="noopener"><%= WarpEngine::AdminIcons.svg(:external, size: 13) %>Docs page</a><% end %>
      <% if !admin_api.openapi_requires_auth? && admin_api.public_docs_url.present? %><a class="we-si-link" href="<%= admin_api.public_docs_url %>" target="_blank" rel="noopener"><%= WarpEngine::AdminIcons.svg(:external, size: 13) %>Public reference</a><% end %>
      <% if admin_api.mcp? %><span>MCP: <code><%= warp_engine.api_admin_mcp_path %></code></span><% end %>
    </div>
    <div class="we-ar-wrap">
      <div class="we-ar-head">
        <h3 class="we-ar-title"><%= reference.title %></h3>
        <span class="we-ar-badge"><%= reference.version %></span>
        <span class="we-ar-badge">OpenAPI 3.1</span>
      </div>
      <p class="we-ar-desc"><%= reference.description %></p>
      <div class="we-ar-base">
        <span>Base URL <code><%= reference.server_url %></code></span>
        <span>Header <code>Authorization: Bearer &lt;token&gt;</code></span>
      </div>
      <% if reference.auth.present? %><p class="we-ar-desc"><%= reference.auth %></p><% end %>
      <div class="we-ar-tools">
        <label class="we-ar-filter"><%= WarpEngine::AdminIcons.svg(:search, size: 15) %><input type="search" placeholder="Filter operations: path, summary, scope…" data-ar-filter aria-label="Filter operations"></label>
        <span class="we-ar-count" data-ar-count><%= reference.operation_count %> operations</span>
      </div>

      <% reference.groups.each do |group| %>
        <section class="we-ar-group" data-ar-group>
          <h4 class="we-ar-gname"><%= group.name %> <span class="we-ar-count"><%= group.operations.size %></span></h4>
          <% group.operations.each do |op| %>
            <details class="we-ar-op" id="<%= op.anchor %>" data-ar-op data-search="<%= op.search_text %> <%= group.name.downcase %>">
              <summary>
                <span class="we-ar-verb we-ar-<%= op.verb %>"><%= op.verb %></span>
                <span class="we-ar-path"><%= op.path.gsub(/\{([^}]+)\}/) { "<i>{#{ERB::Util.h(Regexp.last_match(1))}}</i>" }.html_safe %></span>
                <span class="we-ar-sum"><%= op.summary %></span>
                <span class="we-ar-scope"><%= op.scope %></span>
              </summary>
              <div class="we-ar-body">
                <% if op.description.present? && op.description != op.summary %><p class="we-ar-desc"><%= op.description %></p><% end %>
                <% if op.parameters.any? %>
                  <div>
                    <p class="we-ar-h">Parameters</p>
                    <table class="we-ar-table">
                      <thead><tr><th>Name</th><th>In</th><th>Type</th><th>Description</th></tr></thead>
                      <tbody>
                        <% op.parameters.each do |field| %>
                          <tr>
                            <td class="we-ar-name"><%= field.name %><% if field.required %><span class="we-ar-req">required</span><% end %></td>
                            <td class="we-ar-type"><%= field.location %></td>
                            <td class="we-ar-type"><%= type_cell.call(field) %></td>
                            <td><%= field.description %><% field.notes.each do |note| %><span class="we-ar-note"><%= note %></span><% end %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>
                <% if op.body.any? %>
                  <div>
                    <p class="we-ar-h">Request body <span class="we-ar-type"><%= op.media %></span></p>
                    <table class="we-ar-table">
                      <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
                      <tbody>
                        <% op.body.each do |field| %>
                          <tr>
                            <td class="we-ar-name"><%= field.name %><% if field.required %><span class="we-ar-req">required</span><% end %></td>
                            <td class="we-ar-type"><%= type_cell.call(field) %></td>
                            <td><%= field.description %><% field.notes.each do |note| %><span class="we-ar-note"><%= note %></span><% end %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>
                <% success, errors = op.responses.partition(&:success?) %>
                <% success.each do |response| %>
                  <div>
                    <p class="we-ar-h">Response <span class="we-ar-type"><%= response.status %> · <%= response.description %></span></p>
                    <% if response.fields.any? %>
                      <table class="we-ar-table">
                        <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
                        <tbody>
                          <% response.fields.each do |field| %>
                            <tr>
                              <td class="we-ar-name"><%= field.name %></td>
                              <td class="we-ar-type"><%= type_cell.call(field) %></td>
                              <td><%= field.description %><% field.notes.each do |note| %><span class="we-ar-note"><%= note %></span><% end %></td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    <% end %>
                  </div>
                <% end %>
                <% if errors.any? %>
                  <div>
                    <p class="we-ar-h">Errors <% if errors.first.ref %><span class="we-ar-type">body <a href="#<%= WarpEngine::ApiReference.schema_anchor(errors.first.ref) %>" data-ar-schema="<%= WarpEngine::ApiReference.schema_anchor(errors.first.ref) %>"><%= errors.first.ref %></a></span><% end %></p>
                    <div class="we-ar-codes"><% errors.each do |response| %><span class="we-ar-code" title="<%= response.description %>"><b><%= response.status %></b> <%= response.description %></span><% end %></div>
                  </div>
                <% end %>
                <div class="we-ar-curl"><pre><%= op.curl %></pre><button type="button" class="we-ar-copy" data-ar-copy>Copy</button></div>
              </div>
            </details>
          <% end %>
        </section>
      <% end %>
      <div class="we-si-empty" data-ar-empty hidden>No operation matches.</div>

      <details class="we-ar-schemas">
        <summary><%= WarpEngine::AdminIcons.svg(:chevron, size: 14, css_class: "we-si-chev", stroke: 2.4) %> Schemas <span class="we-ar-count"><%= reference.schemas.size %></span></summary>
        <% reference.schemas.each do |schema| %>
          <details class="we-ar-schema" id="<%= schema.anchor %>">
            <summary><%= schema.name %></summary>
            <div>
              <% if schema.description.present? %><p class="we-ar-desc"><%= schema.description %></p><% end %>
              <% if schema.fields.any? %>
                <table class="we-ar-table">
                  <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
                  <tbody>
                    <% schema.fields.each do |field| %>
                      <tr>
                        <td class="we-ar-name"><%= field.name %><% if field.required %><span class="we-ar-req">required</span><% end %></td>
                        <td class="we-ar-type"><%= type_cell.call(field) %></td>
                        <td><%= field.description %><% field.notes.each do |note| %><span class="we-ar-note"><%= note %></span><% end %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% else %>
                <p class="we-ar-desc">No fields.</p>
              <% end %>
            </div>
          </details>
        <% end %>
      </details>
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById("we-si-api-ref");
      if (!root) return;
      var all = function (sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); };
      var input = root.querySelector("[data-ar-filter]");
      var count = root.querySelector("[data-ar-count]");
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        all("[data-ar-group]").forEach(function (group) {
          var any = false;
          group.querySelectorAll("[data-ar-op]").forEach(function (op) {
            var hit = !q || op.getAttribute("data-search").indexOf(q) !== -1;
            op.hidden = !hit;
            if (hit) { any = true; shown += 1; }
          });
          group.hidden = !any;
        });
        count.textContent = shown + " operations";
        root.querySelector("[data-ar-empty]").hidden = shown > 0;
      });
      root.addEventListener("click", function (event) {
        var link = event.target.closest("[data-ar-schema]");
        if (link) {
          event.preventDefault();
          var target = document.getElementById(link.getAttribute("data-ar-schema"));
          if (!target) return;
          for (var el = target; el && el !== root; el = el.parentElement) { if (el.tagName === "DETAILS") el.open = true; }
          target.scrollIntoView({ behavior: "smooth", block: "center" });
          target.classList.add("we-ar-flash");
          setTimeout(function () { target.classList.remove("we-ar-flash"); }, 1200);
          return;
        }
        var copy = event.target.closest("[data-ar-copy]");
        if (copy && navigator.clipboard) {
          navigator.clipboard.writeText(copy.previousElementSibling.textContent).then(function () {
            copy.textContent = "Copied";
            setTimeout(function () { copy.textContent = "Copy"; }, 1200);
          });
        }
      });
    })();
  </script>
</details>
